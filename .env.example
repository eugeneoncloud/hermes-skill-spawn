# hermes-skill-onboard — environment configuration
# Copy to .env and fill in your values:
#   cp .env.example .env
#
# Or run the interactive setup:
#   bash scripts/setup.sh

# ─── Slack ────────────────────────────────────────────────────────────────────

# Bot User OAuth Token (required)
# Source: https://api.slack.com/apps > Your App > OAuth & Permissions
# Format: xoxb-...
SLACK_BOT_TOKEN=

# App-Level Token (required for socket mode / event subscriptions)
# Source: https://api.slack.com/apps > Your App > Basic Information > App-Level Tokens
# Format: xapp-...
SLACK_APP_TOKEN=
